# Pied Piper Environment Configuration
ENVIRONMENT=development
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=8000
SIGNALING_URL=ws://localhost:8000/ws
# Comma-separated STUN servers (Google port 19302 and Cloudflare standard port 3478)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# TURN Relay Configuration (required when peers are on different networks behind Symmetric NAT / CGNAT / enterprise firewalls)
# Example: turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
CHUNK_SIZE_BYTES=16384
SLIDING_WINDOW_SIZE=32
SQLITE_PATH=./pied_piper.db
LOG_LEVEL=INFO
ROOM_TTL_SECONDS=900
